def max_profit(prices):
    buy = prices[0]
    profit = 0
    for price in prices:
        if price < buy:
            buy = price
        current_profit = price - buy
        if current_profit > profit:
            profit = current_profit
    return profit
prices = [7, 1, 5, 3, 6, 4]
print(max_profit(prices))
