def lengthOfLastWord(s):
    i = 0
    last_length = 0
    current_length = 0
    while i < len(s):
        if s[i] != ' ':
            current_length += 1
            last_length = current_length
        else:
            current_length = 0
        i += 1
    return last_length
s="Hello world"
print(lengthOfLastWord(s))
