
def is_valid(s):
    stack = []

    for char in s:
        if char == '(':
            stack.append(')')
        elif char == '[':
            stack.append(']')
        elif char == '{':
            stack.append('}')
        elif not stack or stack.pop() != char:
            return False

    return len(stack) == 0
print(is_valid("([)]"))
